{
  "name": "regenic",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=!@regenic/desktop run build",
    "dev:api": "pnpm --filter @regenic/api start:dev",
    "dev:worker": "pnpm --filter @regenic/worker start:dev",
    "dev:desktop": "pnpm --filter @regenic/desktop dev",
    "local": "pnpm --filter @regenic/dsh-connector --filter @regenic/lexical-index --filter @regenic/local-cli build && node ./packages/local-cli/dist/main.js",
    "start:api": "pnpm --filter @regenic/api start",
    "start:worker": "pnpm --filter @regenic/worker start",
    "check:boundaries": "node scripts/check-dependency-boundaries.mjs",
    "test": "pnpm -r --workspace-concurrency=1 --if-present run test",
    "typecheck": "pnpm -r run typecheck",
    "test:ci": "node scripts/testing/run.mjs pr",
    "test:host": "node scripts/testing/run.mjs host",
    "test:soak": "node scripts/testing/run.mjs soak",
    "test:consumer": "node scripts/testing/consumer.mjs",
    "test:compatibility": "node scripts/testing/compatibility.mjs",
    "test:desktop": "node scripts/testing/run.mjs desktop",
    "test:report": "node scripts/testing/report.mjs",
    "test:tooling": "node --test scripts/testing/test/*.test.mjs"
  }
}
