NODE_ENV=development
PORT=3000
LISTEN_HOST=127.0.0.1
DATABASE_URL=postgres://regenic:regenic@localhost:5432/regenic
REDIS_URL=redis://localhost:6379
REGENIC_DATABASE=./regenic.db
REGENIC_BLOB_ROOT=./blobs
REGENIC_ORG=local-owner
# Desktop sidecars generate this per process. Set the same value on a remote
# kernel and on the desktop when using a custom kernel URL.
# REGENIC_PERSONAL_API_KEY=
# REGENIC_PERSONAL_API=1 enables /v1/me on a non-loopback LISTEN_HOST (Sealos, etc).
# REGENIC_PERSONAL_API=
# Optional cited context answers. Defaults to none.
REGENIC_MODEL_DRIVER=none
# REGENIC_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# REGENIC_MODEL_NAME=local-model
# REGENIC_MODEL_API_KEY_REF=env:OPENAI_API_KEY
# REGENIC_MODEL_TIMEOUT_MS=30000
# REGENIC_MODEL_MAX_RESPONSE_BYTES=1048576
# OPENAI_API_KEY=
# REGENIC_DSH_API_TOKEN=
# REGENIC_DSH_TOKEN=
# Optional. The Cursor install form can also paste the key.
# CURSOR_API_KEY=
# REGENIC_CURSOR_API_BASE=
