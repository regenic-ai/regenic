# Gitignored after copy:
#   cp deploy/sealos/regenic.local.yaml.example deploy/sealos/regenic.local.yaml
# Fill the public host for this workspace, then:
#   kubectl apply -f deploy/sealos/regenic.yaml -f deploy/sealos/regenic.local.yaml
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: regenic
  labels:
    app: regenic
    cloud.sealos.io/app-deploy-manager: regenic
    cloud.sealos.io/app-deploy-manager-domain: api-example
  annotations:
    kubernetes.io/ingress.class: nginx
    nginx.ingress.kubernetes.io/backend-protocol: HTTP
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
    nginx.ingress.kubernetes.io/proxy-body-size: 32m
    nginx.ingress.kubernetes.io/proxy-read-timeout: "300"
    nginx.ingress.kubernetes.io/proxy-send-timeout: "300"
spec:
  tls:
    - hosts:
        - api.example.site
      secretName: wildcard-cert
  rules:
    - host: api.example.site
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: regenic
                port:
                  number: 3000
