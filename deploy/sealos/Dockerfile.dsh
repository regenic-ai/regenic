# Sidecar for Sealos: dsh is installed at image build time.
# Cluster ephemeral-storage is ~100Mi, so do not npm-install in the Pod.
#
#   docker build --platform linux/amd64 -t jesonli/dsh:main -f deploy/sealos/Dockerfile.dsh deploy/sealos
#   docker push jesonli/dsh:main
FROM node:22-bookworm

ENV npm_config_update_notifier=false \
    npm_config_fund=false

RUN npm install -g @deepseek-ai/dsh \
  && dsh --help >/dev/null

USER node
WORKDIR /home/node

# Official dsh web binds 127.0.0.1 only. Keep it off the Service.
CMD ["dsh", "web", "--no-open", "--port", "3080"]
