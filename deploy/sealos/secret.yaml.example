# Copy to secret.yaml (gitignored) and fill real values.
#   cp deploy/sealos/secret.yaml.example deploy/sealos/secret.yaml
#   kubectl apply -f deploy/sealos/secret.yaml -f deploy/sealos/regenic.yaml
apiVersion: v1
kind: Secret
metadata:
  name: regenic-secrets
type: Opaque
stringData:
  # Callers hitting Regenic HTTP (Authorization: Bearer ...)
  REGENIC_DSH_API_TOKEN: "replace-with-a-long-random-token"
  # dsh calling the model. Process env wins over ~/.dsh files.
  DEEPSEEK_API_KEY: "sk-replace-me"
