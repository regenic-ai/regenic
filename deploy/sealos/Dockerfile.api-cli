# Obsolete after DSH was split out (deploy/sealos/dsh.yaml).
# The API now talks HTTP to http://regenic-dsh:3080 and should use
# jesonli/regenic-core:main (node:20-bookworm-slim, ~100MB).
# This overlay is huge because it starts from full node:22-bookworm,
# installs python3/make/g++, copies the whole app, and npm-installs dsh.
# Do not build or deploy :cli unless you are debugging CLI transport.
#
#   docker build --platform linux/amd64 --target api -t jesonli/regenic-core:main .
ARG API_IMAGE=jesonli/regenic-core:main
FROM ${API_IMAGE} AS app

FROM node:22-bookworm
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@9.15.0 --activate
COPY --from=app /app /app
# Root API image is Node 20. `pnpm rebuild` keeps the existing ABI-115
# prebuild; delete it and fetch the Node 22 binary.
RUN set -eux \
  && dir="$(find /app/node_modules/.pnpm -maxdepth 1 -type d -name 'better-sqlite3@*')" \
  && cd "$dir/node_modules/better-sqlite3" \
  && rm -rf build \
  && npx --yes prebuild-install \
  && node -e "require('.')"
RUN npm install -g @deepseek-ai/dsh \
  && dsh --help >/dev/null
ENV NODE_ENV=production
EXPOSE 3000
CMD ["pnpm", "--filter", "@regenic/api", "start"]
