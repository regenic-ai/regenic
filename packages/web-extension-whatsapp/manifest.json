{
  "manifest_version": 3,
  "name": "Regenic WhatsApp Web Live Connector",
  "version": "0.1.16",
  "description": "Local-only WhatsApp Web connector for Regenic. Observes messages and can draft replies through a localhost API.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://127.0.0.1/*",
    "https://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content-script.js"],
      "type": "module",
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Regenic WhatsApp",
    "default_popup": "popup.html"
  },
  "options_page": "settings.html",
  "web_accessible_resources": [
    {
      "resources": ["content-script.js", "page-logic.js"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ]
}
