{
  "name": "@regenic/lexical-index",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @regenic/plugin-host build && pnpm --filter @regenic/domain build && pnpm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@regenic/domain": "workspace:*",
    "@regenic/plugin-host": "workspace:*",
    "better-sqlite3": "11.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
