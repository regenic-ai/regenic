{
  "name": "@regenic/dsh-connector",
  "version": "0.0.0",
  "private": true,
  "regenic": {
    "plugin": true,
    "catalogOrder": 20,
    "id": "@regenic/dsh-connector",
    "displayName": "DSH",
    "engines": {
      "regenic": "1.0"
    },
    "contributes": {
      "drivers": [
        "dshSessionDriver"
      ],
      "executors": [
        "dshTaskExecutor"
      ]
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm --filter @regenic/plugin-host build && pnpm --filter @regenic/connector-contract build && pnpm --filter @regenic/connector-test-utils build && pnpm run build && node --test test/*.test.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@regenic/connector-contract": "workspace:*",
    "@regenic/plugin-host": "workspace:*",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@regenic/connector-test-utils": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.2",
    "typescript": "^5.7.2"
  }
}
