{
  "name": "@regenic/cursor-connector",
  "version": "0.0.0",
  "private": true,
  "regenic": {
    "plugin": true,
    "catalogOrder": 40,
    "id": "@regenic/cursor-connector",
    "displayName": "Cursor",
    "engines": {
      "regenic": "1.0"
    },
    "contributes": {
      "drivers": [
        "cursorAgentDriver"
      ]
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm --filter @regenic/plugin-host build && pnpm --filter @regenic/connector-contract build && pnpm --filter @regenic/connector-test-utils build && pnpm run build && node --test test/*.test.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cursor/sdk": "^1.2.0",
    "@regenic/plugin-host": "workspace:*",
    "@regenic/connector-contract": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "@regenic/connector-test-utils": "workspace:*"
  }
}
