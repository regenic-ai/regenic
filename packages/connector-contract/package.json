{
  "name": "@regenic/connector-contract",
  "version": "0.1.0",
  "description": "Serializable types and pure helpers for Regenic connectors.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regenic-ai/regenic.git",
    "directory": "packages/connector-contract"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@regenic/plugin-host": "workspace:*",
    "zod": "^3.24.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run build && node --test test/*.test.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
