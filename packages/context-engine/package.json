{
  "name": "@regenic/context-engine",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @regenic/plugin-host build && pnpm --filter @regenic/domain build && pnpm --filter @regenic/blob-store build && pnpm --filter @regenic/authority-store build && pnpm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@regenic/domain": "workspace:*",
    "@regenic/plugin-host": "workspace:*"
  },
  "devDependencies": {
    "@regenic/authority-store": "workspace:*",
    "@regenic/blob-store": "workspace:*",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}