{
  "name": "@regenic/feishu-connector",
  "version": "0.0.0",
  "private": true,
  "regenic": {
    "plugin": true,
    "catalogOrder": 30,
    "id": "@regenic/feishu-connector",
    "displayName": "Feishu",
    "engines": { "regenic": "1.0" },
    "contributes": {
      "drivers": ["feishuChatDriver"]
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm --filter @regenic/plugin-host build && pnpm --filter @regenic/domain build && pnpm run build && node --test test/*.test.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@regenic/domain": "workspace:*",
    "@regenic/plugin-host": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
