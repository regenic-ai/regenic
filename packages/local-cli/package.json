{
  "name": "@regenic/local-cli",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "bin": {
    "regenic-local": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "bench:semantic": "pnpm --filter @regenic/local-cli... build && node test/semantic-retrieval.bench.cjs",
    "test": "pnpm --filter @regenic/local-cli... build && node --test test/*.test.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@regenic/authority-store": "workspace:*",
    "@regenic/blob-store": "workspace:*",
    "@regenic/context-engine": "workspace:*",
    "@regenic/domain": "workspace:*",
    "@regenic/embedding-provider": "workspace:*",
    "@regenic/lexical-index": "workspace:*",
    "@regenic/plugin-host": "workspace:*",
    "@regenic/vector-index": "workspace:*",
    "@regenic/dsh-connector": "workspace:*",
    "@regenic/model-provider": "workspace:*",
    "@regenic/slack-connector": "workspace:*",
    "@regenic/whatsapp-personal": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}