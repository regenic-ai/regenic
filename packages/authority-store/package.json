{
  "name": "@regenic/authority-store",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite/index.d.ts",
      "default": "./dist/sqlite/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "default": "./dist/postgres/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "sqlite": ["./dist/sqlite/index.d.ts"],
      "postgres": ["./dist/postgres/index.d.ts"]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm --filter @regenic/plugin-host build && pnpm --filter @regenic/domain build && pnpm --filter @regenic/blob-store build && pnpm run build && node --test test/*.test.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@regenic/domain": "workspace:*",
    "@regenic/plugin-host": "workspace:*",
    "better-sqlite3": "11.10.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@regenic/blob-store": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}