{
  "name": "@regenic/server-app-connector",
  "version": "0.0.0",
  "private": true,
  "regenic": {
    "plugin": true,
    "catalogOrder": 40,
    "id": "@regenic/server-app-connector",
    "displayName": "Server app",
    "engines": { "regenic": "1.0" },
    "contributes": { "drivers": ["serverAppDriver"] }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @regenic/connector-contract build && pnpm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@regenic/connector-contract": "workspace:*",
    "@regenic/plugin-host": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
