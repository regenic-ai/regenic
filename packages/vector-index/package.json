{
  "name": "@regenic/vector-index",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bench:authorization": "pnpm build && node test/vector-authorization-scale.bench.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @regenic/vector-index... build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@regenic/domain": "workspace:*",
    "@regenic/plugin-host": "workspace:*",
    "better-sqlite3": "13.1.1",
    "sqlite-vec": "0.1.9"
  },
  "devDependencies": { "@types/better-sqlite3": "^7.6.13", "@types/node": "^22.10.2", "typescript": "^5.7.2" }
}
