{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["electron-vite/node"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*.ts",
    "src/main/**/*.d.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
